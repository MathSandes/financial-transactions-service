generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id               String   @id @default(uuid())
  amountCents      BigInt
  currency         String   @default("BRL")
  type             TransactionType
  description      String?
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())
}

enum TransactionType {
  CREDIT
  DEBIT
}
